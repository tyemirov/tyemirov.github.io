                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                }
