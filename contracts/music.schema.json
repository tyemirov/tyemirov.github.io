{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tyemirov.net/contracts/music.schema.json",
  "$ref": "#/$defs/catalog",
  "$defs": {
    "playback": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "external"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "hls"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 7200250
            }
          },
          "required": [
            "kind",
            "durationMs"
          ]
        }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "playback": {
          "$ref": "#/$defs/playback"
        }
      },
      "required": [
        "id",
        "title",
        "playback"
      ]
    },
    "releaseDate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "precision": {
              "const": "year"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4,
              "pattern": "^[0-9]{4}$"
            }
          },
          "required": [
            "precision",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "precision": {
              "const": "day"
            },
            "value": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "precision",
            "value"
          ]
        }
      ]
    },
    "album": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "not": {
            "enum": [
              "covers",
              "dist",
              "player"
            ]
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "displayTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "translation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "coverImage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "^/music/covers/[a-z0-9-]+\\.(jpg|jpeg|png|webp)$"
        },
        "releaseDate": {
          "$ref": "#/$defs/releaseDate"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "live"
          ]
        },
        "latest": {
          "type": "boolean"
        },
        "shortDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "streamingLinks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spotify": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^https://[^/@?#\\s]+(?:/[^\\s]*)?$",
              "format": "uri"
            },
            "apple": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^https://[^/@?#\\s]+(?:/[^\\s]*)?$",
              "format": "uri"
            },
            "youtube": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^https://[^/@?#\\s]+(?:/[^\\s]*)?$",
              "format": "uri"
            },
            "amazon": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^https://[^/@?#\\s]+(?:/[^\\s]*)?$",
              "format": "uri"
            },
            "suno": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^https://[^/@?#\\s]+(?:/[^\\s]*)?$",
              "format": "uri"
            }
          },
          "required": [],
          "minProperties": 1
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "credits": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "commonmark"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000000,
              "pattern": "\\S"
            }
          },
          "required": [
            "format",
            "text"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "slug",
        "title",
        "subtitle",
        "coverImage",
        "releaseDate",
        "status",
        "shortDescription",
        "streamingLinks",
        "tracks",
        "credits",
        "notes",
        "order"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/album"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "label",
        "title",
        "items"
      ]
    },
    "grantInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "trackId"
      ]
    },
    "expiration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "expiresAt"
      ]
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 22,
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "playlistUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https://[^/@?#\\s]+(?:/[^\\s]*)?$",
          "format": "uri"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 7200250
        },
        "serverTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "grantId",
        "trackId",
        "playlistUrl",
        "durationMs",
        "serverTime",
        "expiresAt"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        }
      },
      "required": [
        "code",
        "message",
        "requestId"
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status"
      ]
    }
  }
}
