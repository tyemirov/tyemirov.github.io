FROM mwader/static-ffmpeg:8.1.2@sha256:33f770f812cbfc3de96c547157fc9faf8bd95a36481753439ffa761045167585 AS ffmpeg
FROM golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd AS go
FROM node:26.5.1-bookworm-slim@sha256:9e6f9357d371591e32ab6f2d8a26d63bdd0d17c29eee3f4f3e7e454d9634bf73 AS node
FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
RUN apt-get update && apt-get install -y --no-install-recommends make gcc libc6-dev perl git openssl python3 python3-venv ca-certificates rsync && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/ansible && /opt/ansible/bin/pip install --no-cache-dir ansible-core==2.19.8 && /opt/ansible/bin/ansible-galaxy collection install -p /opt/ansible/collections community.docker:5.1.0 community.library_inventory_filtering_v1:1.1.5
COPY --from=ffmpeg /ffmpeg /ffprobe /usr/local/bin/
COPY --from=go /usr/local/go /usr/local/go
COPY --from=node /usr/local/bin/node /usr/local/bin/node
ENV PATH="/usr/local/go/bin:${PATH}" PLAYWRIGHT_BROWSERS_PATH=/ms-playwright CI=1
ENV ANSIBLE_PLAYBOOK=/opt/ansible/bin/ansible-playbook ANSIBLE_INVENTORY_BIN=/opt/ansible/bin/ansible-inventory ANSIBLE_COLLECTIONS_PATH=/opt/ansible/collections
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY services/gallery/go.mod services/gallery/go.sum ./services/gallery/
RUN cd services/gallery && go mod download
COPY . .
RUN git init -q && git add .
CMD ["bash", "tests/music/run-ci.sh"]
