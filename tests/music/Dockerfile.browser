FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tests/music/host-browser-client.mjs tests/music/shared-ui-assets.mjs ./tests/music/
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright CI=1
CMD ["node", "tests/music/host-browser-client.mjs"]
